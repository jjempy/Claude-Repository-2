POSTGRES_PASSWORD=leanshop_secret
JWT_SECRET=supersecretjwtkey_change_in_production
NODE_ENV=production

# Backend URL (used by Docker Compose and local dev)
API_URL=http://localhost:4000

# Vercel deployment: set BACKEND_URL to your Railway backend public domain.
# The Next.js proxy (/api/* → BACKEND_URL/*) handles routing — no NEXT_PUBLIC_API_URL needed.
# BACKEND_URL=https://your-app.up.railway.app
